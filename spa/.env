# OIDC configuration — baked into the SPA at build time via Vite's import.meta.env.
# All values here match CONTRACT §7 exactly.
#
# Storage: oidc-client-ts defaults to sessionStorage for tokens (OidcStorage).
# sessionStorage is scoped per browser tab/session and is never persisted to disk,
# which is appropriate for a local PoC with short-lived access tokens.
# Override with stateStore / userStore options if persistent login is needed.
#
# These are intentionally public (no secrets) — this is a PUBLIC OIDC client (PKCE).

VITE_OIDC_AUTHORITY=http://auth.localhost:8000/application/o/app/
VITE_OIDC_CLIENT_ID=spa-client
VITE_OIDC_REDIRECT_URI=http://app.localhost:8000/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://app.localhost:8000/
VITE_OIDC_SCOPE=openid profile email groups api offline_access
