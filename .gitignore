# =============================================================================
# .gitignore
# =============================================================================

# Environment / secrets — NEVER commit .env (use .env.example instead)
.env

# Node / SPA build artifacts
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Go build artifacts
api/bin/
api/internal/oapi/   # generated by ogen; regenerated by `task`
*.test
*.out

# Playwright / test artifacts
tests/playwright-report/
tests/test-results/
playwright/.cache/

# Docker / compose runtime state
*.log

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
