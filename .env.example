# =============================================================================
# .env.example — LOCAL / DEMO environment variables
# =============================================================================
# ALL secrets in this file are intentionally PUBLIC, local-only demo values.
# They MUST NEVER be reused outside this local PoC.
# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env
# .env is git-ignored; .env.example is tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# authentik — SECRET KEY
# Used to sign sessions and internal tokens. Must be long and random in prod.
# LOCAL/DEMO ONLY
# -----------------------------------------------------------------------------
AUTHENTIK_SECRET_KEY=local-demo-secret-key-change-me-please-0123456789abcdef

# -----------------------------------------------------------------------------
# authentik — Bootstrap admin (break-glass only; normal users come from Dex)
# LOCAL/DEMO ONLY
# -----------------------------------------------------------------------------
AUTHENTIK_BOOTSTRAP_PASSWORD=akadmin-local-demo-password
AUTHENTIK_BOOTSTRAP_TOKEN=local-demo-bootstrap-token-0123456789
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@localhost

# -----------------------------------------------------------------------------
# authentik — PostgreSQL credentials
# LOCAL/DEMO ONLY
# -----------------------------------------------------------------------------
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=authentik-local-demo-db-password

# -----------------------------------------------------------------------------
# Dex — OIDC client secret (used by authentik to authenticate to Dex)
# Must match the value in dex/config.yml staticClients section.
# LOCAL/DEMO ONLY
# -----------------------------------------------------------------------------
DEX_CLIENT_SECRET=authentik-dex-secret-LOCAL-DEMO-ONLY

# -----------------------------------------------------------------------------
# Dex — client_id (informational; hardcoded in config but kept here for docs)
# -----------------------------------------------------------------------------
DEX_CLIENT_ID=authentik
